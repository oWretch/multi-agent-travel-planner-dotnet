{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare local environment",
      "type": "shell",
      "command": "azd env get-values > \"${workspaceFolder}/.vscode/.env\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/MultiAgentTravelPlanner/MultiAgentTravelPlanner.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "prepare local demo",
      "dependsOrder": "sequence",
      "dependsOn": [
        "prepare local environment",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/src/MultiAgentTravelPlanner/MultiAgentTravelPlanner.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/src/MultiAgentTravelPlanner/MultiAgentTravelPlanner.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}